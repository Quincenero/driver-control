# ===========================================
# SERVIDOR
# ===========================================
PORT=4000
NODE_ENV=development

# ===========================================
# MONGODB
# ===========================================
# Local:
# MONGO_URI=mongodb://localhost:27017/driver-control-pro
# Atlas (reemplazar con tus credenciales):
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/driver-control-pro?retryWrites=true&w=majority

# ===========================================
# JWT
# ===========================================
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reemplazar_con_un_secreto_largo_y_aleatorio
JWT_EXPIRE=30d

# ===========================================
# FRONTEND
# ===========================================
# URL usada para construir links en emails (reset password, etc.)
FRONTEND_URL=http://localhost:5173

# ===========================================
# RESEND (emails transaccionales)
# ===========================================
# Obtener API Key en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx